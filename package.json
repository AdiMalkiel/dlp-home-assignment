{
  "name": "dlp-backend",
  "version": "1.0.0",
  "description": "Simplified DLP platform backend",
  "scripts": {
    "dev": "node --env-file=.env --import=tsx --watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:local": "node --env-file=.env dist/server.js",
    "migrate:create": "kysely migrate:make",
    "migrate:latest": "kysely migrate:latest",
    "migrate:down": "kysely migrate:down",
    "migrate:list": "kysely migrate:list",
    "db:codegen": "kysely-codegen --out-file src/db/types.ts",
    "db:seed": "tsx --env-file=.env .config/seed.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "kysely-ctl": "^0.21.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "express": "^5.2.1",
    "http-status-codes": "^2.3.0",
    "kysely": "^0.29.5",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  }
}
